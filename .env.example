# Frontend build variables are intentionally minimal.
# Configure provider and database secrets as Cloudflare Pages secrets; never commit.
APP_ENV=demo
DEFAULT_MARKETPLACE=EBAY_US
PUBLIC_API_VERSION=v1

# Cloudflare account (deployment + Workers AI + Browser Run)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
BROWSER_RUN_CANARY=

# eBay Developer application (official Browse API)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Free multi-route AI (JSON array of OpenAI-compatible endpoints; Groq/Gemini/OpenRouter :free)
AI_ROUTES=

# Legacy single-provider AI vars
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

# Public reader fallback (Jina Reader, documented open endpoint; opt-in)
USE_JINA_READER=1

# Durable storage (optional; R2 S3-compatible credentials)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
